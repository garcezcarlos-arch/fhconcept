NEXT_PUBLIC_SUPABASE_URL=https://ezcfnokwomxqzrdamicb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://fhconcept.com.br
# Mercado Pago — Access Token de PRODUCAO da aplicacao (painel do desenvolvedor). Sem ele a loja fecha o pagamento pelo WhatsApp.
MERCADOPAGO_ACCESS_TOKEN=
# Mercado Pago — "Assinatura secreta" de Webhooks (Suas integracoes > Webhooks). Com ela o webhook recusa notificacao falsa.
MERCADOPAGO_WEBHOOK_SECRET=
# Segredo do cron de reconciliacao (a Vercel envia como Bearer). Gere um valor aleatorio longo.
CRON_SECRET=
# Melhor Envio — token de acesso (Painel > Integracoes > Permissoes de acesso > Gerar token, escopo shipping-calculate).
# Sem ele o checkout segue com frete "a confirmar no WhatsApp".
MELHORENVIO_TOKEN=
# E-mail de contato tecnico exigido pelo Melhor Envio no User-Agent
MELHORENVIO_CONTATO=
# Opcionais: 1 = usar o sandbox; servicos (1 PAC, 2 SEDEX); CEP de origem (padrao: CEP do salao)
MELHORENVIO_SANDBOX=
MELHORENVIO_SERVICOS=1,2
MELHORENVIO_CEP_ORIGEM=
# E-mail (Resend) — chave da API e remetente de um dominio verificado no Resend. Sem eles nenhum e-mail e enviado.
RESEND_API_KEY=
EMAIL_REMETENTE=FH Concept <loja@fhconcept.com.br>
# Caixa que recebe os avisos de novo pedido / pedido pago (e o "responder" das clientes)
EMAIL_LOJA=
